rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated app users (admins & employees) to read and upload receipts, chat photos, etc.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /admins/{adminUid}/receipts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

